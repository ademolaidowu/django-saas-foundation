# ============================================================================
# Core
# ============================================================================
SECRET_KEY=change-me-in-production
DEBUG=True

# Choose exactly one of LOCAL / PROD. TESTING is set automatically by pytest.
LOCAL=True
PROD=False

# Comma-separated. "*" is only safe in local.
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/django_saas_foundation

# Used by entrypoint.sh for `pg_isready` before migrations.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres

# ============================================================================
# Redis (cache only for now)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Tenancy guard
# ============================================================================
# "strict" raises UnscopedQueryError; "warn" emits a warning.
TENANT_GUARD_MODE=strict

# ============================================================================
# Entrypoint behaviour (Docker)
# ============================================================================
# Run `seed_demo` on container boot. Set to "false" in production deploys.
SEED_DEMO=true

# Gunicorn worker count.
GUNICORN_WORKERS=3
